[Unit]
Description=Streamlit RAG Chatbot Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/RAG_CHATBOT
Environment="PATH=/home/ubuntu/RAG_CHATBOT/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/RAG_CHATBOT/.venv/bin/python -m streamlit run app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
